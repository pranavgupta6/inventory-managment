# ============================================================
# Inventory Management System — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to source control.
# ============================================================

# ---------------------------------------------------------
# Lark / Feishu Provider Selection
# ---------------------------------------------------------
# Choose which platform your organization uses.
# Valid values: "lark" | "feishu"
# "lark"   → uses https://open.larksuite.com (international)
# "feishu" → uses https://open.feishu.cn (China mainland)
LARK_PROVIDER=lark

# ---------------------------------------------------------
# Lark / Feishu Application Credentials
# ---------------------------------------------------------
# Obtain these from the Lark Open Platform developer console:
#   Lark:   https://open.larksuite.com/app
#   Feishu: https://open.feishu.cn/app
LARK_APP_ID=
LARK_APP_SECRET=

# ---------------------------------------------------------
# Bitable Base Token
# ---------------------------------------------------------
# The unique identifier for your Bitable (Base) document.
# Find it in the URL:  …/base/<APP_TOKEN>/…
LARK_BITABLE_APP_TOKEN=

# ---------------------------------------------------------
# Bitable Table IDs  (optional at startup; required for each feature)
# ---------------------------------------------------------
# The unique identifier for each table inside the Base.
# Leave blank during initial setup; populate as tables are created.
LARK_TABLE_INVENTORY=
LARK_TABLE_EMPLOYEES=
LARK_TABLE_ASSIGNMENTS=
LARK_TABLE_REQUESTS=

# ---------------------------------------------------------
# Backend Server
# ---------------------------------------------------------
NODE_ENV=development
PORT=3001

# ---------------------------------------------------------
# CORS — Frontend Origin
# ---------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# In development, this is typically http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------
# Rate Limiting  (optional; defaults shown)
# ---------------------------------------------------------
# Maximum requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------
# Email Notifications (SMTP Configuration)
# ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Inventory System <no-reply@yourcompany.com>"
ADMIN_EMAIL="admin@yourcompany.com"
